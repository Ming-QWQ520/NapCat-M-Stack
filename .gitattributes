# 统一换行策略：
# - PowerShell / 批处理在 Windows 上必须 CRLF（PS 5.1 与 cmd.exe 的边界行为）
# - Shell 脚本必须 LF
# - 二进制文件不做任何转换
* text=auto

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.psm1  text eol=crlf

*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

*.png   binary
*.jpg   binary
*.ico   binary
*.zip   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
